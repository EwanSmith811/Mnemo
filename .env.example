# Copy to .env.local and fill in your own credentials.
# These values are server-only. Never use a NEXT_PUBLIC_ prefix.

# Required: OpenAI API key for text generation and voice features.
OPENAI_API_KEY=

# Optional: model overrides (defaults shown).
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Required: Neon pooled PostgreSQL URL, including sslmode=require.
DATABASE_URL=

# Optional: Neon direct connection for database administration.
# The application currently uses DATABASE_URL above.
DATABASE_URL_UNPOOLED=
